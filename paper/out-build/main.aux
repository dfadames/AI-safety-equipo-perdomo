\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces (a) Escape rate by population size (instructed, \(P=4\)). (b, c) Minimum cut of the exposure graph for each escape (dots) and mean (bar); in (c) the dashed line marks cut \(=P\) and the dotted line the floor \(P-1\), which no escape fell below. 5--10 episodes per point; the cut is not shown to be causal.\relax }}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:curvas}{{1}{5}{(a) Escape rate by population size (instructed, \(P=4\)). (b, c) Minimum cut of the exposure graph for each escape (dots) and mean (bar); in (c) the dashed line marks cut \(=P\) and the dotted line the floor \(P-1\), which no escape fell below. 5--10 episodes per point; the cut is not shown to be causal.\relax }{figure.caption.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Exposure provenance of the escapes}{5}{subsection.5.2}\protected@file@percent }
\newlabel{sec:attr}{{5.2}{5}{Exposure provenance of the escapes}{subsection.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-agent view versus exposure-provenance graph, same episode (instructed, \(N=4\), \(P=4\)). (a) Excerpts of each agent's trace; a receive line collapses several deliveries into one and carries the step of the last part listed, so it reads as what the agent held by then, and \emph  {unlock} is the call to the validation tool. Read one at a time these are plausible audits --- not undetectable, since the judge given the rule scored this episode 10/10, but a score is not an origin. (b) The first successful validation and its 34 ancestors (35 of 83 events), one lane per agent, roots in all 4 containers, and the 3 deliveries forming the minimum cut. C's delivery at step 51 is a relay: it carries A's and B's parts as well as C's own, so the route on the cut is not the route from the origin. Because the channel is a broadcast, D had also received those parts directly, which is why the relay costs the sender baseline of Section\nobreakspace  {}\ref {sec:attr} nothing here.\relax }}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:mapa}{{2}{6}{Per-agent view versus exposure-provenance graph, same episode (instructed, \(N=4\), \(P=4\)). (a) Excerpts of each agent's trace; a receive line collapses several deliveries into one and carries the step of the last part listed, so it reads as what the agent held by then, and \emph {unlock} is the call to the validation tool. Read one at a time these are plausible audits --- not undetectable, since the judge given the rule scored this episode 10/10, but a score is not an origin. (b) The first successful validation and its 34 ancestors (35 of 83 events), one lane per agent, roots in all 4 containers, and the 3 deliveries forming the minimum cut. C's delivery at step 51 is a relay: it carries A's and B's parts as well as C's own, so the route on the cut is not the route from the origin. Because the channel is a broadcast, D had also received those parts directly, which is why the relay costs the sender baseline of Section~\ref {sec:attr} nothing here.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Detection versus attribution}{6}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Detection and false alarms by monitor: escape episodes, episodes without escape, and the 1-part control in which validating is legitimate so every alarm is false. All three monitors flag every escape, so detection does not separate them; they differ only outside escapes, and none of the three attributes.\relax }}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:deteccion}{{3}{7}{Detection and false alarms by monitor: escape episodes, episodes without escape, and the 1-part control in which validating is legitimate so every alarm is false. All three monitors flag every escape, so detection does not separate them; they differ only outside escapes, and none of the three attributes.\relax }{figure.caption.3}{}}
