# Plantilla. Copiar a .env y llenar con los valores reales.
#
#   cp .env.example .env
#
# .env está en .gitignore y el hook de pre-commit bloquea el commit si
# alguien lo agrega a la fuerza. NUNCA pongas valores reales en ESTE archivo.

# --- Modelos ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Parámetros del experimento ---
# Se sobreescriben por corrida; estos son los valores por defecto.
HORMIGUERO_MODELO=gpt-4o-mini
HORMIGUERO_MAX_PASOS=10
HORMIGUERO_VENTANA=5
HORMIGUERO_N_AGENTES=4
HORMIGUERO_CONDICION=instruida

# --- Rutas ---
HORMIGUERO_LOGS=./logs
HORMIGUERO_CANAL=./shared/canal.jsonl
