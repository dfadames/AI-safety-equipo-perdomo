# Plantilla. `sh setup.sh` la copia a .env — y ESE es el que se lee.
# NUNCA pongas valores reales en ESTE archivo: este sí se sube al repo.
#
# .env está en .gitignore y el hook de pre-commit bloquea el commit si alguien
# lo agrega a la fuerza.

# ---------------------------------------------------------------
# La llave. Es lo único que hay que llenar.
# ---------------------------------------------------------------
# https://platform.deepseek.com  ->  API keys
DEEPSEEK_API_KEY=

# Comprobar que sirve, sin gastar un barrido:
#   cd CS && python -m hormiguero.proveedores.deepseek

# ---------------------------------------------------------------
# Con qué corre el runner si no se le pasa --proveedor
# ---------------------------------------------------------------
#   simulado  guion fijo, sin red ni tokens — para probar el cableado
#   deepseek  modelo real, gasta tokens
#   glm       el segundo modelo del barrido (Z.ai) — ver abajo
HORMIGUERO_PROVEEDOR=deepseek
DEEPSEEK_MODELO=deepseek-flash

# ---------------------------------------------------------------
# GLM (Z.ai) — el segundo modelo. Con la llave puesta ya corre.
# ---------------------------------------------------------------
# https://z.ai  ->  API keys
GLM_API_KEY=

# Comprobar llave y modelo antes de gastar un barrido:
#   cd CS && python -m hormiguero.proveedores.glm
# Correr el lote entero con GLM:
#   cd CS && python -m hormiguero.plan --proveedor glm
#
# El nombre exacto del modelo sale de la consola de Z.ai. Solo hace falta
# ponerlo si no es el de por defecto (glm-5.3):
# GLM_MODELO=glm-5.3
#
# Y el endpoint, solo si su plan usa otro compatible con OpenAI:
# GLM_BASE_URL=https://api.z.ai/api/openai/v1

# ---------------------------------------------------------------
# Otros backends (opcionales, solo si alguien los usa)
# ---------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODELO=gpt-4o-mini

# ---------------------------------------------------------------
# Parámetros del experimento
# ---------------------------------------------------------------
# Se sobreescriben por corrida con --N/--condicion/etc; estos son los valores
# por defecto.
HORMIGUERO_MAX_PASOS=10
HORMIGUERO_N_AGENTES=4
HORMIGUERO_CONDICION=instruida

# --- Rutas ---
HORMIGUERO_LOGS=./logs
HORMIGUERO_CANAL=./shared/canal.jsonl
