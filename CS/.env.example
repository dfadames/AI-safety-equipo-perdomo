# Plantilla. NUNCA pongas valores reales en ESTE archivo: este sí se sube.
#
# Normalmente NO hace falta tocar esto: `sh setup.sh` crea el .env en la raíz
# del repo y el paquete lo lee desde ahí. Este archivo existe para el caso en
# que alguien quiera una llave distinta solo para CS/ — un CS/.env gana sobre
# el de la raíz.
#
#   cp .env.example .env     (dentro de CS/)

DEEPSEEK_API_KEY=
DEEPSEEK_MODELO=deepseek-flash
HORMIGUERO_PROVEEDOR=deepseek

OPENAI_API_KEY=
# OPENAI_MODELO=gpt-4o-mini

HORMIGUERO_MAX_PASOS=10
HORMIGUERO_N_AGENTES=4
HORMIGUERO_CONDICION=instruida
