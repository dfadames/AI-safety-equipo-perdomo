# Plantilla. Copiar a .env y llenar con los valores reales.
#
#   cp .env.example .env
#
# .env está en .gitignore (ver la raíz del repo). NUNCA pongas valores reales
# en ESTE archivo.

# --- Modelos ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Parámetros del experimento ---
# Se sobreescriben por corrida via --N/--condicion/etc; estos son los valores
# por defecto si algún proveedor los lee de entorno.
HORMIGUERO_MODELO=gpt-4o-mini
HORMIGUERO_MAX_PASOS=10
HORMIGUERO_N_AGENTES=4
HORMIGUERO_CONDICION=instruida
